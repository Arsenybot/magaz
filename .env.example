# Database configuration: defaults to SQLite embedded relational database (data/store.db), or provide PostgreSQL URL
DATABASE_URL="file:./data/store.db"

# Telegram Bot configuration
# Obtain from @BotFather in Telegram
TELEGRAM_BOT_TOKEN="your_bot_token_here"

# WebApp URL where this application is hosted (e.g. your Cloud Run or dev tunnel URL)
TELEGRAM_WEBAPP_URL="https://ais-dev-m5ld77pudm2royunh4okdc-400970295787.europe-west3.run.app"

# Comma-separated list of Telegram User IDs granted Administrator permissions
ADMIN_TELEGRAM_IDS="123456789,987654321"

# Payment Provider: "mock" (for development/testing), "telegram" (Telegram Stars / Payments), or "yookassa"
PAYMENT_PROVIDER="mock"

# API keys and secrets for external payment providers (YooKassa / Telegram Provider Token)
PAYMENT_API_KEY="test_api_key_or_shop_id"
PAYMENT_SECRET="test_secret_key"

# Environment: "development" or "production"
NODE_ENV="development"

# Server Port
PORT=3000
